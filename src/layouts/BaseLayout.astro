---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  theme?: "home" | "research";
}

const {
  title = site.name,
  description = "Willem Davison — PhD student in Computer Vision and Robotics at the University of Edinburgh.",
  theme = "home",
} = Astro.props;

const pageTitle =
  title === site.name
    ? title
    : `${title} — ${site.name}`;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin
);

const isHomePage = Astro.url.pathname === "/";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://widavison.github.io/#website",
  name: site.name,
  alternateName: ["Willem Davison Research", "widavison"],
  url: "https://widavison.github.io/",
  publisher: {
    "@type": "Person",
    name: site.name,
    url: "https://widavison.github.io/",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="canonical" href={canonicalURL.toString()} />
    <meta name="robots" content="index, follow" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="google-site-verification" content="0xk7_0uS7VoDzf70qD-i0ccOzO_pitOWMmHW_89pbqg" />

    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/favicon.png"
    />

    <meta name="description" content={description} />

    <meta name="application-name" content={site.name} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:type" content="website" />

    {isHomePage && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(websiteSchema)}
      />
    )}

    <title>{pageTitle}</title>
  </head>

  <body class={`theme-${theme}`}>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
