---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Willem Davison",
  description = "Willem Davison — PhD student in Computer Vision and Robotics at the University of Edinburgh.",
} = Astro.props;

const pageTitle =
  title === "Willem Davison"
    ? title
    : `${title} — Willem Davison`;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin
);

const isHomePage = Astro.url.pathname === "/";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Willem Davison",
  alternateName: "Willem Davison Research",
  url: "https://widavison.github.io/",
};
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="canonical" href={canonicalURL.toString()} />
    <meta name="robots" content="index, follow" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="google-site-verification" content="0xk7_0uS7VoDzf70qD-i0ccOzO_pitOWMmHW_89pbqg" />

    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/favicon.png"
    />

    <meta name="description" content={description} />

    <meta property="og:site_name" content="Willem Davison" />

    {isHomePage && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(websiteSchema)}
      />
    )}

    <title>{pageTitle}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>