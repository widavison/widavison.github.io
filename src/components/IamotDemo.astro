<div class="motion-demo" data-iamot-demo data-assets="/demo/iamot/">
  <div class="demo-heading">
    <div>
      <p class="demo-kicker">animated point-tracks extracted using <a href="https://cotracker3.github.io/" target="_blank" rel="noopener noreferrer">CoTracker3 ↗</a></p>
      <p class="demo-instruction">The action displayed is efficiently represented by the motion of just a few point-tracks. The RGB video includes redundant background and context information which does not represent the action.</p>
    </div>
  </div>

  <div class="motion-bar">
    <span class="desktop-hint">hover during playback to reveal video</span>
    <span class="touch-hint">tap reveal video during playback</span>
  </div>

  <div
    class="motion-frame"
    data-iamot-viewport
    tabindex="0"
    role="group"
    aria-label="Juggling point tracks. During playback, hover or focus to reveal the original video; tracks remain visible."
    aria-busy="true"
  >
    <video data-iamot-video muted loop playsinline preload="none" aria-hidden="true"></video>
    <img data-iamot-poster src="/demo/iamot/poster.jpg" width="914" height="716" loading="lazy" alt="Colourful trajectories tracing the motion of five juggling balls" />
    <canvas data-iamot-canvas width="914" height="716" aria-hidden="true" hidden></canvas>
    <p class="motion-message" data-iamot-message role="status" hidden></p>
  </div>

  <div class="playback-controls">
    <div class="timeline-controls">
      <button type="button" data-iamot-play disabled>play</button>
      <input type="range" data-iamot-timeline aria-label="Juggling video time" min="0" max="4.033333" step="0.033333333" value="0" disabled />
      <span class="time-readout" data-iamot-time>0.0 / 4.0 s</span>
    </div>
    <div class="view-controls">
      <button type="button" class="mobile-reveal" data-iamot-reveal aria-pressed="false" disabled>reveal video</button>
    </div>
  </div>
</div>

<script>
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      observer.unobserve(entry.target);
      const root = entry.target as HTMLElement;
      import("../scripts/iamot-viewer").then(({ initIamotViewer }) => initIamotViewer(root)).catch((error) => {
        console.error("Could not load the IAMOT demo", error);
        const message = root.querySelector<HTMLElement>("[data-iamot-message]")!;
        message.textContent = "Could not load the motion demo. Refresh to try again.";
        message.hidden = false;
        root.querySelector("[data-iamot-viewport]")!.setAttribute("aria-busy", "false");
      });
    }
  }, { rootMargin: "300px" });
  document.querySelectorAll("[data-iamot-demo]").forEach((root) => observer.observe(root));
</script>

<style>
  .motion-demo { container-type: inline-size; width: 100%; min-width: 0; overflow: hidden; border: 1px solid var(--border); background: var(--surface); }
  [hidden] { display: none !important; }
  .demo-heading { min-height: 144px; padding: 12px 14px; display: flex; align-items: center; border-bottom: 1px solid var(--border); }
  .demo-kicker { margin: 0 0 8px; color: var(--home-accent); font-size: .65rem; letter-spacing: .07em; }
  .demo-kicker a { text-decoration: underline; text-underline-offset: 3px; }
  .demo-instruction { margin: 0; color: var(--text); font-size: .82rem; }
  .motion-bar { height: 59px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--border); color: var(--muted); font-size: .65rem; }
  .touch-hint { display: none; }
  .motion-frame { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #000; }
  .motion-frame video, .motion-frame canvas, .motion-frame img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  .motion-frame video { opacity: 0; transition: opacity 650ms ease-in-out; }
  .motion-frame canvas { z-index: 1; pointer-events: none; }
  .motion-demo[data-revealed="true"] video { opacity: 1; }
  .motion-demo[data-playback="paused"] video { opacity: 0; transition: none; }
  .motion-frame:focus-visible { outline: 2px solid var(--home-accent); outline-offset: -2px; }
  .motion-message { position: absolute; inset: 0; display: grid; place-content: center; margin: 0; padding: 20px; background: #000; color: var(--text); text-align: center; font-size: .8rem; }
  .playback-controls { min-height: 52px; display: grid; gap: 8px; padding: 10px 14px; border-top: 1px solid var(--border); color: var(--muted); font-size: .7rem; }
  .timeline-controls, .view-controls { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .view-controls { display: none; }
  button { min-height: 30px; padding: 4px 8px; border: 1px solid var(--border); background: transparent; color: var(--muted); font-family: inherit; font-size: .74rem; cursor: pointer; }
  button:disabled { cursor: default; opacity: .5; }
  button:focus-visible, input:focus-visible { outline: 2px solid var(--home-accent); outline-offset: 3px; }
  .timeline-controls > button { min-width: 56px; }
  input[type="range"] { flex: 1; min-width: 0; width: 0; accent-color: var(--home-accent); }
  .time-readout { flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .mobile-reveal { display: none; margin-left: auto; }
  .mobile-reveal[aria-pressed="true"] { color: var(--background); border-color: var(--home-accent); background: var(--home-accent); }
  @container (max-width: 420px) {
    .demo-heading { min-height: 180px; }
    .motion-bar { height: 90px; flex-direction: column; align-items: flex-start; justify-content: center; gap: 8px; }
    .motion-frame { aspect-ratio: 4 / 3; }
  }
  @media (hover: none), (pointer: coarse), (max-width: 760px) {
    .view-controls { display: flex; }
    .mobile-reveal { display: inline-block; }
    .desktop-hint { display: none; }
    .touch-hint { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) { .motion-frame video { transition: none; } }
</style>
