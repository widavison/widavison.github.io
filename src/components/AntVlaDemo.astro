<div class="rollout-demo" data-rollout-demo data-assets="/demo/antvla/3d/">
  <div class="demo-heading">
    <div>
      <p class="demo-kicker">Interactive 3D rollout</p>
      <p class="demo-instruction">“Place the green avocado in the paper box.”</p>
    </div>

  </div>

  <div class="policy-bar">
    <div class="policy-switch" role="group" aria-label="Choose rollout">
      <button type="button" data-policy="baseline" aria-pressed="false" disabled>
        baseline
      </button>
      <button type="button" data-policy="antvla" aria-pressed="true" disabled>
        AntVLA
      </button>
    </div>

    <span class="playback-state" data-rollout-state aria-live="polite">loading 3D scene…</span>
  </div>

  <div class="scene-frame" data-rollout-viewport aria-busy="true">
    <canvas
      data-rollout-canvas
      role="img"
      aria-label="Interactive 3D Franka robot replaying recorded joint motion. Drag to orbit and scroll or pinch to zoom."
    ></canvas>
    <span class="scene-label" data-rollout-label>AntVLA</span>
    <p class="scene-message" data-rollout-message role="status">Loading robot and recorded motion…</p>
    <span class="orbit-hint">drag to orbit · scroll / pinch to zoom</span>
    <noscript><p class="scene-message">Enable JavaScript to view the 3D robot animation.</p></noscript>
  </div>

  <div class="playback-controls">
    <div class="timeline-controls">
      <button type="button" data-rollout-play disabled>play</button>
      <input
        type="range"
        data-rollout-timeline
        aria-label="Rollout time"
        min="0"
        max="1"
        step="0.001"
        value="0"
        disabled
      />
      <span class="time-readout" data-rollout-time>0.0 / 0.0 s</span>
    </div>
    <div class="view-controls">
      <label class="speed-control">
        speed
        <select data-rollout-speed aria-label="Playback speed" disabled>
          <option value="0.5">0.5×</option>
          <option value="1" selected>1×</option>
          <option value="2">2×</option>
        </select>
      </label>
      <label class="loop-control"><input type="checkbox" data-rollout-loop checked disabled /> loop</label>
    </div>
  </div>
</div>

<script>
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      observer.unobserve(entry.target);
      const root = entry.target as HTMLElement;
      import("../scripts/antvla-viewer").then(({ initRolloutViewer }) => initRolloutViewer(root)).catch((error) => {
        console.error("Could not load the 3D viewer", error);
        root.querySelector("[data-rollout-state]")!.textContent = "3D unavailable";
        root.querySelector("[data-rollout-message]")!.textContent = "Could not load the 3D viewer. Refresh to try again.";
        root.querySelector("[data-rollout-viewport]")!.setAttribute("aria-busy", "false");
      });
    }
  }, { rootMargin: "300px" });

  document.querySelectorAll("[data-rollout-demo]").forEach((root) => observer.observe(root));
</script>

