---
import "../styles/demos.css";
---

<div class="demo-panel rollout-demo" data-rollout-demo data-assets="/demo/antvla/3d/">
  <div class="demo-toolbar">
    <p class="demo-hint">click to compare rollouts</p>
    <div class="demo-options" role="group" aria-label="Switch between baseline and AntVLA rollouts">
      <button type="button" data-policy="baseline" aria-pressed="false" disabled>Baseline · misses</button>
      <button type="button" data-policy="antvla" aria-pressed="true" disabled>AntVLA · succeeds</button>
    </div>
  </div>

  <div class="demo-frame scene-frame" data-rollout-viewport aria-busy="true">
    <canvas
      data-rollout-canvas
      role="img"
      aria-label="AntVLA rollout: anticipates the moving avocado and places it in the box. Drag to rotate; scroll or pinch to zoom."
    ></canvas>
    <span class="orbit-hint" aria-hidden="true">
      <span class="mouse-hint">drag to rotate · scroll to zoom</span>
      <span class="touch-hint">drag to rotate · pinch to zoom</span>
    </span>
    <p class="scene-message" data-rollout-message role="status">Loading robot and recorded motion…</p>
    <noscript><p class="scene-message">Enable JavaScript to view the 3D robot animation.</p></noscript>
  </div>

  <div class="demo-heading">
    <p class="demo-kicker">pick and place command: “Place the green avocado in the paper box.”</p>
    <p class="demo-instruction">The baseline model attempts to grasp the object in an outdated position. AntVLA anticipates the object's motion and completes the task successfully.</p>
  </div>
</div>

<script>
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      observer.unobserve(entry.target);
      const root = entry.target as HTMLElement;
      import("../scripts/antvla-viewer").then(({ initRolloutViewer }) => initRolloutViewer(root)).catch((error) => {
        console.error("Could not load the 3D viewer", error);
        root.querySelector("[data-rollout-message]")!.textContent = "Could not load the 3D viewer. Refresh to try again.";
        root.querySelector("[data-rollout-viewport]")!.setAttribute("aria-busy", "false");
      });
    }
  }, { rootMargin: "600px" });

  document.querySelectorAll("[data-rollout-demo]").forEach((root) => observer.observe(root));
</script>

<style>
  .scene-frame { background: var(--surface-light); }
  .scene-frame canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  .orbit-hint { position: absolute; bottom: 8px; left: 8px; padding: 4px 6px; background: color-mix(in srgb, var(--background) 85%, transparent); color: var(--muted); font-size: .62rem; line-height: 1.4; pointer-events: none; }
  .touch-hint { display: none; }
  @media (hover: none), (pointer: coarse) {
    .mouse-hint { display: none; }
    .touch-hint { display: inline; }
  }
  .scene-message { position: absolute; inset: 0; display: grid; place-content: center; margin: 0; padding: 28px; color: var(--text); background: var(--surface-light); text-align: center; }
  .scene-message[hidden] { display: none; }
</style>
