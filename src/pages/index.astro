---
import { Image } from "astro:assets";
import portrait from "../assets/images/portrait.jpg";
import AntVlaDemo from "../components/AntVlaDemo.astro";
import IamotDemo from "../components/IamotDemo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout description="Willem Davison — PhD student researching computer vision and robotics at the University of Edinburgh.">
  <div class="container">
    <section class="hero home-hero">
      <div class="hero-copy">
        <h1>{site.name}</h1>

        <p class="hero-role">{site.role}</p>
        <p class="muted">{site.institution}</p>
      </div>

      <div class="image-frame profile-image-frame">
        <Image
          src={portrait}
          alt="Willem Davison at Edinburgh Castle"
          width={1224}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero-about">
        <p class="section-label">00 / about</p>

        <p>
          Hi, I'm Willem! I'm a PhD student at the University of Edinburgh
          researching robotics and computer vision. I work in the video vision
          research group within the Institute of Perception, Action and Behaviour
          (IPAB) under the supervision of Dr Laura Sevilla-Lara. My research
          focuses on leveraging motion information and temporal dynamics for
          applications in fast and efficient video understanding, and real-time
          embodied AI control in dynamic environments.
        </p>

        <p>
          Outside of my research, I am an avid cyclist and hiker and regularly organise week long adventures with my friends, I love playing
          squash, and I enjoy photography. I also explore various personal
          projects including jewellery making and 3D printing.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <p class="section-label">01 / selected work</p>

        <a href="/research/" class="text-link">
          explore research →
        </a>
      </div>

      <div class="selected-work-grid">
        <article class="work-card selected-work-card" id="iamot-demo">
          <div class="selected-work-header">
            <p class="status">preprint · under review</p>
            <div class="work-links iamot-paper-link">
              <a
                href="https://arxiv.org/abs/2602.14705"
                target="_blank"
                rel="noopener noreferrer"
              >
                paper ↗
              </a>
            </div>
          </div>

          <h2>
            It's a Matter of Time: Three Lessons on Long-Term Motion for
            Perception
          </h2>

          <p class="work-summary">
            Investigating what long-term motion representations can reveal about
            actions, objects, materials and spatial structure.
          </p>

          <IamotDemo />
        </article>

        <article class="work-card selected-work-card" id="antvla-demo">
          <p class="status">in progress</p>

          <h2>
            AntVLA: Anticipatory Action Adaptation for VLAs in Dynamic Tasks
          </h2>

          <p class="work-summary">
            Developing anticipatory action adaptation for vision-language-action
            models operating in dynamic tasks.
          </p>

          <AntVlaDemo />
        </article>
      </div>
    </section>

    <section class="section">
      <p class="section-label">02 / updates</p>

      <article class="update">
        <time datetime="2026-10-26">2026.10.26</time>

        <div>
          <h2>Website created!</h2>
          <p>Personal website created — updates to come.</p>
        </div>
      </article>

      <article class="update">
        <time datetime="2026-02-16">2026.02.16</time>

        <div>
          <h2>"It's a Matter of Time" preprint released</h2>
          <p> Version 1 of paper "It's a Matter of Time: Three Lessons on Long-Term Motion for Perception" publicly released on arXiv.</p>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .selected-work-header { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .selected-work-header .status { margin-bottom: 0; }
  .selected-work-header .iamot-paper-link { margin: 0 0 0 auto; white-space: nowrap; }
</style>
