---
import { Image } from "astro:assets";
import researchRobot from "../assets/images/research-robot.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Research"
  description="Research by Willem Davison in computer vision, video understanding and robotics."
>
  <div class="container">
    <section class="page-intro">
      <div>
        <p class="eyebrow">research</p>
        <h1>Research</h1>

        <p class="lead">
          My research focuses on motion, temporal reasoning and embodied
          intelligence across computer vision and robotics.
        </p>
      </div>

      <div class="image-frame">
        <Image
          src={researchRobot}
          alt="Willem Davison standing beside a humanoid robot"
        />
      </div>
    </section>

    <section class="section">
      <p class="section-label">01 / questions</p>

      <div class="research-question-list">
        <article>
          <h2>Vision Language Action models</h2>
          <p>Enabling zero-shot generalist robot control.</p>
        </article>

        <article>
          <h2>Robot manipulation in dynamic tasks</h2>
          <p>
            An essential, and often neglected, robot capability.
          </p>
        </article>

        <article>
          <h2>Motion as a visual information stream</h2>
          <p>
            Endowing vision models with advanced temporal reasoning skills.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <p class="section-label">02 / current work</p>

      <div class="work-list">
        <article class="work-card">
          <p class="status">under review</p>

          <h2>
            It's a Matter of Time: Three Lessons on Long-Term Motion for
            Perception
          </h2>

          <div class="work-links">
            <a
              href="https://arxiv.org/abs/2602.14705"
              target="_blank"
              rel="noopener noreferrer"
            >
              paper ↗
            </a>
          </div>
        </article>

        <article class="work-card">
          <p class="status">in progress</p>

          <h2>
            AntVLA: Anticipatory Action Adaptation for VLAs in Dynamic Tasks
          </h2>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>