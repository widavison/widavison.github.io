---
import { Image } from "astro:assets";
import researchRobot from "../assets/images/research-robot.jpg";
import matterOfTimeImg from "../assets/images/its_a_matter_of_time.png";
import antVlaImg from "../assets/images/antvla.png";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Research"
  description="Research by Willem Davison in computer vision, video understanding and robotics."
  theme="research"
>
  <div class="container">
    <section class="page-intro research-intro">
      <div class="image-frame research-image-frame">
        <Image
          src={researchRobot}
          alt="Willem Davison standing beside a humanoid robot"
          width={1043}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="research-intro-copy">
        <h1>Research</h1>

        <p class="lead">
          Building AI with Temporal Understanding
        </p>

        <div class="hero-about">
          <p class="section-label">00 / about</p>

          <p>
            My research lies at the intersection of video computer vision and intelligent robotic control, with a focus on dynamic environments.
             My work leverages motion information to build online and emboddied AI models with advanced temporal reasoning capabilities.
          </p>

          <p>
            Currently, I am looking into incorporating future state anticipation into state-of-the-art robotic control models to enable preemptive robot control in dynamic environments.
          </p>

        </div>

      </div>
    </section>

    <section class="section">
      <p class="section-label">01 / themes</p>

      <div class="research-question-list">
        <article>
          <h2>Vision Language Action (VLA) models</h2>
          <p>Enabling zero-shot generalist robot control. VLAs are robot control models built upon Vision Language Models, equipping robots with high level visual and language reasoning capabilities.</p>
        </article>

        <article>
          <h2>Robot manipulation in dynamic tasks</h2>
          <p>
            An essential, and often neglected, robot capability. The real world is inherently dynamic and filled with moving parts. Robots which operate in the real world must understand motion.
          </p>
        </article>

        <article>
          <h2>Motion as a visual information stream</h2>
          <p>
            Endowing vision models with advanced temporal reasoning skills. Motion can be a highly efficient visual representation, allowing long-horizon temporal dependencies to be modelled at a low information cost.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <p class="section-label">02 / current work</p>

      <div class="work-list">
        <article class="work-card">
          <div class="work-card-content">
            <p class="status">under review</p>

            <h2>
              It's a Matter of Time: Three Lessons on Long-Term Motion for
              Perception
            </h2>

            <p class="co-authors">
              Willem Davison, Maggie Hao, Laura Sevilla-Lara
            </p>

            <div class="work-links">
              <a
                href="https://arxiv.org/abs/2602.14705"
                target="_blank"
                rel="noopener noreferrer"
              >
                paper ↗
              </a>
            </div>
          </div>

          <div class="work-image">
            <Image
              src={matterOfTimeImg}
              alt="Point tracking visualisations"
            />
          </div>
        </article>

        <article class="work-card">
          <div class="work-card-content">
            <p class="status">in progress</p>

            <h2>
              AntVLA: Anticipatory Action Adaptation for VLAs in Dynamic Tasks
            </h2>

            <div class="work-image">
              <Image
                src={antVlaImg}
                alt="Visualization of AntVLA"
              />
            </div>
          </div>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
